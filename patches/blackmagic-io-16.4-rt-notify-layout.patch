--- a/bmio_client.h
+++ b/bmio_client.h
@@ -49,10 +49,35 @@
 typedef struct bmio_notify_list
 {
 	struct list_head head;
+#if defined(CONFIG_PREEMPT_RT) && defined(CONFIG_X86_64)
+	/*
+	 * Desktop Video 16.4's prebuilt x86_64 notification functions expect
+	 * lock/count at offsets 0x28/0x30. PREEMPT_RT enlarges wait_queue_head_t
+	 * from 24 to 48 bytes, so embedding it here shifts those fields.
+	 * Preserve the binary ABI prefix; keep the C-only wait queue last.
+	 * This compatibility change is specific to the inspected x86_64 blob.
+	 */
+	u8 wait_abi_reserved[24];
+#else
 	wait_queue_head_t wait;
+#endif
 	bm_spinlock_t* lock;
 	size_t count;
+#if defined(CONFIG_PREEMPT_RT) && defined(CONFIG_X86_64)
+	wait_queue_head_t wait;
+#endif
 } bmio_notify_list_t;
+
+#if defined(CONFIG_PREEMPT_RT) && defined(CONFIG_X86_64)
+_Static_assert(offsetof(bmio_notify_list_t, head) == 0,
+	"Blackmagic notification head ABI mismatch");
+_Static_assert(offsetof(bmio_notify_list_t, lock) == 0x28,
+	"Blackmagic notification lock ABI mismatch");
+_Static_assert(offsetof(bmio_notify_list_t, count) == 0x30,
+	"Blackmagic notification count ABI mismatch");
+_Static_assert(offsetof(bmio_notify_list_t, wait) >= 0x38,
+	"Blackmagic wait queue overlaps the notification ABI prefix");
+#endif
 
 typedef struct bmio_client_mmap
 {
