<launch>
  <arg name="namespace" default="/endoscope"/>
  <arg name="publish_rate" default="30"/>
  <arg name="device_index" default="0"/>
  <arg name="mode" default="1080p5994"/>
  <arg name="frame_id" default="camera"/>
  <arg name="buffer_count" default="4"/>
  <arg name="left_calibration" default="$(find-pkg-share endoscope_capture)/config/DefaultStereoCalibration/left.yaml"/>
  <arg name="right_calibration" default="$(find-pkg-share endoscope_capture)/config/DefaultStereoCalibration/right.yaml"/>
  <arg name="camera_info_url" default=""/>
  <arg name="scale_x" default="0.5"/>
  <arg name="scale_y" default="1.0"/>
  <arg name="opencv_threads" default="1"/>
  <arg name="duration_seconds" default="0"/>
  <arg name="metrics_file" default=""/>
  <arg name="split_metrics_file" default=""/>
  <arg name="qos_reliability" default="reliable"/>
  <arg name="qos_depth" default="4"/>
  <node pkg="endoscope_capture" exec="endoscope_capture_node" name="capture"
        namespace="$(var namespace)" output="screen">
    <param name="publish_rate" value="$(var publish_rate)" type="float"/>
    <param name="device_index" value="$(var device_index)" type="int"/>
    <param name="mode" value="$(var mode)" type="str"/>
    <param name="frame_id" value="$(var frame_id)" type="str"/>
    <param name="buffer_count" value="$(var buffer_count)" type="int"/>
    <param name="left_calibration" value="$(var left_calibration)" type="str"/>
    <param name="right_calibration" value="$(var right_calibration)" type="str"/>
    <param name="camera_info_url" value="$(var camera_info_url)" type="str"/>
    <param name="scale_x" value="$(var scale_x)" type="float"/>
    <param name="scale_y" value="$(var scale_y)" type="float"/>
    <param name="opencv_threads" value="$(var opencv_threads)" type="int"/>
    <param name="duration_seconds" value="$(var duration_seconds)" type="float"/>
    <param name="metrics_file" value="$(var metrics_file)" type="str"/>
    <param name="split_metrics_file" value="$(var split_metrics_file)" type="str"/>
    <param name="qos_reliability" value="$(var qos_reliability)" type="str"/>
    <param name="qos_depth" value="$(var qos_depth)" type="int"/>
  </node>
</launch>
